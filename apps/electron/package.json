{
  "name": "hidocknotes-app",
  "version": "0.16.1",
  "description": "Desktop client for a self-hosted HiDockNotes server, with native USB sync.",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": "HiDockNotes contributors",
  "homepage": "https://github.com/Amitai5/HiDockNotes",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "package:mac": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:linux": "electron-builder --config electron-builder.config.cjs --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@hidock/jensen-protocol": "file:../../packages/jensen-protocol",
    "usb": "2.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "^27.4.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
